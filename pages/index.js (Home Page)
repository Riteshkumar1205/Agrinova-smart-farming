import Link from 'next/link';
export default function Home() {
const [language, setLanguage] = useState('en');
const [quote, setQuote] = useState('');


const quotes = {
en: [
"The best time to plant a tree was 20 years ago. The second best time is now.",
"Hard work beats talent when talent doesn’t work hard.",
"Believe you can and you’re halfway there."
],
hi: [
"सबसे अच्छा समय पेड़ लगाने का 20 साल पहले था। दूसरा सबसे अच्छा समय अभी है।",
"कड़ी मेहनत प्रतिभा को हरा देती है जब प्रतिभा मेहनत नहीं करती।",
"विश्वास करो कि तुम कर सकते हो और तुम आधे रास्ते पर हो।"
]
};


useEffect(() => {
const dailyQuote = () => {
const langQuotes = quotes[language] || quotes['en'];
const index = new Date().getDate() % langQuotes.length;
setQuote(langQuotes[index]);
};
dailyQuote();
}, [language]);


const greetings = {
en: 'Welcome to AGRINOVA',
hi: 'AGRINOVA में आपका स्वागत है'
};


return (
<div
className="flex flex-col items-center justify-center min-h-screen bg-cover bg-center"
style={{ backgroundImage: `url('/assets/images/happy_farmer_bg.jpg')` }}
>
<div className="bg-white bg-opacity-70 p-8 rounded-lg shadow-lg text-center">
<h1 className="text-4xl font-bold mb-4">{greetings[language]}</h1>
<div className="mb-4">
<label className="mr-2">Language / भाषा:</label>
<select value={language} onChange={(e) => setLanguage(e.target.value)} className="p-2 border rounded-lg">
<option value="en">English</option>
<option value="hi">हिंदी</option>
</select>
</div>
<p className="text-lg italic mb-6">"{quote}"</p>
<Link href="/dashboard">
<button className="bg-green-600 text-white p-3 rounded-lg hover:bg-green-700 transition">
{language === 'en' ? 'Go to Dashboard' : 'डैशबोर्ड पर जाएं'}
</button>
</Link>
</div>
</div>
);
}
